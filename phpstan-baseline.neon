parameters:
	ignoreErrors:
		-
			message: '#^Call to static method Webmozart\\Assert\\Assert\:\:isInstanceOf\(\) with Sylius\\Component\\Core\\Model\\ShipmentInterface and ''Sylius\\\\Component\\\\Order\\\\Model\\\\AdjustableInterface'' will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: src/Converter/ShippingAdjustmentsToLineItemsConverter.php

		-
			message: '#^Cannot access offset ''allowed_files'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/DependencyInjection/SyliusInvoicingExtension.php

		-
			message: '#^Cannot access offset ''enabled'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/DependencyInjection/SyliusInvoicingExtension.php

		-
			message: '#^Cannot access offset ''legacy'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 2
			path: src/DependencyInjection/SyliusInvoicingExtension.php

		-
			message: '#^Parameter \#2 \$allowedFiles of method Sylius\\InvoicingPlugin\\DependencyInjection\\SyliusInvoicingExtension\:\:registerAllowedFilesProcessor\(\) expects list\<string\>, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/DependencyInjection/SyliusInvoicingExtension.php

		-
			message: '#^Parameter \#2 \$value of method Symfony\\Component\\DependencyInjection\\Container\:\:setParameter\(\) expects array\|bool\|float\|int\|string\|UnitEnum\|null, mixed given\.$#'
